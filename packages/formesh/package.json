{
  "name": "react-formesh",
  "version": "0.1.7",
  "description": "Fine-grained form state management for complex React forms, with a framework-agnostic core and React bindings.",
  "license": "Apache-2.0",
  "author": "Mehedi Hasan",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://github.com/mhasansagor/react-formesh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhasansagor/react-formesh.git"
  },
  "bugs": {
    "url": "https://github.com/mhasansagor/react-formesh/issues"
  },
  "keywords": [
    "react-formesh",
    "react",
    "react-form",
    "form-state",
    "form-management",
    "typescript",
    "forms",
    "form-validation",
    "complex-forms"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./validators": {
      "import": {
        "types": "./dist/validators.d.ts",
        "default": "./dist/validators.js"
      },
      "require": {
        "types": "./dist/validators.d.cts",
        "default": "./dist/validators.cjs"
      }
    },
    "./file": {
      "import": {
        "types": "./dist/file.d.ts",
        "default": "./dist/file.js"
      },
      "require": {
        "types": "./dist/file.d.cts",
        "default": "./dist/file.cjs"
      }
    },
    "./array": {
      "import": {
        "types": "./dist/array.d.ts",
        "default": "./dist/array.js"
      },
      "require": {
        "types": "./dist/array.d.cts",
        "default": "./dist/array.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@testing-library/react": "^15.0.0",
    "@types/react": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "jsdom": "^24.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}